# TDLib (Telegram Client) API credentials
# Получить на https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# OpenAI API для генерации саммари
# Получить на https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# VK Bridge (v0.5.0) — управление через VK-сообщество (VK Bots Long Poll)
# Сообщество: сообщения + «Возможности ботов» + Long Poll API (5.199, «Входящие сообщения»).
# Ключ сообщества: «Управление сообществом» + «Сообщения сообщества». Подробно — README.
VK_BOT_TOKEN=your_vk_community_key
VK_BOT_GROUP_ID=123456789
# VK id тех, кому бот подчиняется (через запятую); сообщения остальных игнорируются
VK_BOT_OWNER_IDS=111111
# VK_API_VERSION=5.199

# Telegram Bot API (v0.6.0, ещё не подключено) — для отправки дайджестов
# 1. Создать бота через @BotFather: /newbot
# 2. Получить Bot Token (формат: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz)
TELEGRAM_BOT_TOKEN=your_bot_token

# Chat ID пользователя для отправки дайджестов
# Как получить:
# 1. Отправь боту /start в Telegram
# 2. Выполни: curl https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
# 3. Найди в JSON: "chat":{"id": 123456789} ← это твой chat_id
TELEGRAM_BOT_CHAT_ID=your_chat_id
